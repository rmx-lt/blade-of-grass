# Component repos live in these folders as their own Git repositories.
# This meta repo only links to them.
/rmx-server/
/rmx-mower/

# Never commit keys or secrets
*_ed25519
*.pem
*.key
*.csr
*.crl
*.srl
.env
.env.*

# Device CA working directory, if a run is pointed at the clone by mistake.
# The real CA belongs in %USERPROFILE%\.rmx-device-ca (see wiki Device-CA).
.rmx-device-ca/

# Editor / OS clutter
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Python
__pycache__/
